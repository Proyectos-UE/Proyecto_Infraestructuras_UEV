# Copia este archivo mediante: python scripts/preparar_config.py
# No subir nunca .env a Git.
DATABASE_URL=sqlite:///./data/trendwatch.db
API_KEY=
POSTGRES_PASSWORD=
WIKI_USER_AGENT=TrendWatch/0.1 (https://github.com/Proyectos-UE/Proyecto_Infraestructuras_6_7)
WIKI_PROJECT=es.wikipedia
# wikipedia = API real; demo = API externa simulada
SOURCE_MODE=wikipedia
