# Copia este archivo a .env y ajusta los valores
DATABASE_URL=sqlite:///./data/trendwatch.db
# Wikimedia exige un User-Agent identificable (pon tu contacto)
WIKI_USER_AGENT=TrendWatch/0.1 (proyecto universitario; contacto: tu_email@ejemplo.com)
WIKI_PROJECT=es.wikipedia
POLL_INTERVAL_SECONDS=86400
HISTORY_DAYS=90
ENABLE_PYTRENDS=false
