# Copia este archivo a ".env" y cambia los valores. NUNCA subas el ".env" a GitHub.

# Clave de administrador (OBLIGATORIA: la API no arranca sin ella). Usa una larga y aleatoria.
ADMIN_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Clave con permisos mínimos: solo puede ejecutar la ingesta (opcional, debe ser distinta de la anterior).
INGEST_API_KEY=cambia-esto-por-otra-clave-distinta

# Wikimedia exige un User-Agent que te identifique con un contacto. Necesario solo para la ingesta REAL.
WIKI_USER_AGENT=TrendWatch/0.3 (proyecto universitario; contacto: tu_email@ejemplo.com)

# Fuente por defecto de la ingesta: "wikipedia" (API real) o "simulated" (API simulada, sin Internet).
INGEST_SOURCE=wikipedia

# Segundos de espera mínima entre dos ingestas del mismo producto (protege a la API externa).
INGEST_COOLDOWN_SECONDS=30

# Búsquedas por minuto y por IP permitidas en /v1/search.
SEARCH_RATE_LIMIT_PER_MINUTE=20

# Archivo de datos (opcional; por defecto data/products.json).
# DATA_FILE=data/products.json
